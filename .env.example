# Copy to .env (gitignored) and fill in. Never commit .env.
# Only variables the server reads today are listed. Each step adds its own.

# trace | debug | info | notice | warning | error | critical
LOG_LEVEL=info

# Set to 1 to build Brain from its pinned git tag instead of ../Brain.
# CI sets this; local development leaves it unset.
BRAIN_FROM_GIT=

# ---- Postgres (Sources/Storage) ----
# Local values match docker-compose.yml. The server requires all five; it
# never falls back to a default. Tests default to brain_test on port 54329.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54329
DATABASE_USER=brain
DATABASE_PASSWORD=
DATABASE_NAME=brain_dev

# ---- Supabase auth (Sources/Auth, ADR-0007) ----
# Project URL only. Issuer and JWKS URL are derived from it. Must be https,
# except a local Supabase on localhost. No JWT secret: HS256 is never used.
SUPABASE_URL=

# ---- Enrichment worker (Sources/Worker) ----
# Google AI Studio key, free tier (ADR-0002). Empty means rules only (T0):
# captures still become items, no model is called, and startup logs a warning.
GOOGLE_AI_API_KEY=
# Captures enriched at the same time. The daily budget, not this, is the real
# limit on model calls.
WORKER_CONCURRENCY=4
