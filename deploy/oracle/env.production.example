# Copy to Server/.env.production on the Mac (gitignored), fill in the three
# marked values, and it is copied to ~/brain/.env on the VM (chmod 600).
# Never commit the filled file.

BRAIN_IMAGE_TAG=
LOG_LEVEL=info

# Supabase Postgres through the shared pooler, SESSION mode (IPv4: the VM has
# no IPv6). Host and user from Dashboard > Connect > Session pooler.
# FILL: aws-<n>-<region>.pooler.supabase.com
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=postgres.rqxvzishfcthajxejvvn
# FILL: Supabase database password
DATABASE_PASSWORD=
DATABASE_NAME=postgres
DATABASE_TLS=verify-full
# REQUIRED for Supabase: the pooler's certificate chains to Supabase's own
# root (Database > Settings > SSL, prod-ca-2021.crt). With system roots only,
# verification fails (checked: openssl code 19), and the server refuses to
# connect rather than connect unverified.
DATABASE_CA_FILE=/app/supabase-ca.crt

SUPABASE_URL=https://rqxvzishfcthajxejvvn.supabase.co

# FILL: Google AI Studio key (free tier)
GOOGLE_AI_API_KEY=
# 1 OCPU. The daily budget, not this, limits model calls.
WORKER_CONCURRENCY=2
